<h1 style="color: #030913; font-size: 24px; line-height: 32px; font-weight: 600; margin: 0 0 24px 0; text-align: center;">
  Trusted Publisher Added to Organization
</h1>

<p style="color: #304254; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">
  <%= OrganizationTrustedPublisherAdd.message(@username, @organization) %>
</p>

<p style="color: #304254; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">
  <%= for line <- OrganizationTrustedPublisherDetails.lines(@role, @repository_owner, @repository, @workflow, @environment, @packages) do %>
    <%= line %><br>
  <% end %>
</p>

<p style="color: #304254; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">
  <%= OrganizationTrustedPublisherAdd.warning(@role, @organization, @packages) %>
</p>
