<h1 style="color: #030913; font-size: 24px; line-height: 32px; font-weight: 600; margin: 0 0 24px 0; text-align: center;">
  Trusted Publisher Added to Package
</h1>

<p style="color: #304254; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">
  <%= TrustedPublisherAdd.message(@username, @package) %>
</p>

<p style="color: #304254; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">
  <%= for line <- TrustedPublisherDetails.lines(@repository, @workflow, @environment) do %>
    <%= line %><br>
  <% end %>
</p>

<p style="color: #304254; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">
  <%= TrustedPublisherAdd.warning(@package) %>
</p>
