<h1 style="color: #030913; font-size: 24px; line-height: 32px; font-weight: 600; margin: 0 0 24px 0; text-align: center;">
  Workload Identity Changed in Organization
</h1>

<p style="color: #304254; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">
  <%= raw(OrganizationWorkloadIdentityChange.message(@username, @organization, :html)) %>
</p>

<p style="color: #304254; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">
  <%= WorkloadIdentityChange.before() %><br>
  <%= for line <- OrganizationWorkloadIdentityDetails.lines(@role, @previous, @organization, @previous_coverage) do %>
    <%= line %><br>
  <% end %>
</p>

<p style="color: #304254; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">
  <%= WorkloadIdentityChange.now() %><br>
  <%= for line <- OrganizationWorkloadIdentityDetails.lines(@role, @current, @organization, @coverage) do %>
    <%= line %><br>
  <% end %>
</p>

<p style="color: #304254; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">
  <%= OrganizationWorkloadIdentityAdd.warning(@role, @organization, @coverage) %>
</p>
