<%
invitations_url = url(email_uri(), ~p"/dashboard/invitations")
%>

<h1 style="color: #030913; font-size: 24px; line-height: 32px; font-weight: 600; margin: 0 0 24px 0; text-align: center;">
  Organization Invitation
</h1>

<p style="color: #304254; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">
  <%= OrganizationUserInvitation.intro(@organization, @username, @role) %>
</p>

<p style="color: #304254; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">
  <%= raw(OrganizationUserInvitation.review(invitations_url, :html)) %>
</p>

<p style="color: #304254; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">
  <%= OrganizationUserInvitation.expiry(@expires_at) %>
</p>

<p style="color: #304254; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">
  <%= OrganizationUserInvitation.decline_notice() %>
</p>
