<h1 style="color: #030913; font-size: 24px; line-height: 32px; font-weight: 600; margin: 0 0 24px 0; text-align: center;">
  Owner Added to Package
</h1>

<p style="color: #304254; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">
  <%= OwnerAdd.message(@username, @package) %>
</p>

<%= if @started != [] do %>
<p style="color: #304254; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">
  <%= OwnerAdd.started(@package) %>
</p>

<p style="color: #304254; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">
  <%= for workload_identity <- @started do %>
    <%= OrganizationWorkloadIdentityLine.line(workload_identity) %><br>
  <% end %>
</p>
<% end %>
