<%= WorkloadIdentityChange.message(@username, @package, :text) %>

<%= WorkloadIdentityChange.before() %>
<%= Enum.join(WorkloadIdentityDetails.lines(@previous), "\n") %>

<%= WorkloadIdentityChange.now() %>
<%= Enum.join(WorkloadIdentityDetails.lines(@current), "\n") %>

<%= WorkloadIdentityChange.warning(@package, :text) %>
