<h1 style="color: #030913; font-size: 24px; line-height: 32px; font-weight: 600; margin: 0 0 24px 0; text-align: center;">
  Owner Removed from Package
</h1>

<p style="color: #304254; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">
  <%= OwnerRemove.message(@username, @package) %>
</p>

<%= if @workload_identities != [] do %>
<p style="color: #304254; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">
  <%= OwnerRemove.workload_identities(@package) %>
</p>

<p style="color: #304254; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">
  <%= for workload_identity <- @workload_identities do %>
    <%= workload_identity.repository %> (<%= workload_identity.workflow %>)<br>
  <% end %>
</p>

<p style="color: #304254; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">
  <%= raw(OwnerRemove.review(@workload_identities_url, :html)) %>
</p>
<% end %>
