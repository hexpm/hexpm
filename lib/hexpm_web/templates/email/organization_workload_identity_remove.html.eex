<h1 style="color: #030913; font-size: 24px; line-height: 32px; font-weight: 600; margin: 0 0 24px 0; text-align: center;">
  Workload Identity Removed from Organization
</h1>

<p style="color: #304254; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">
  <%= OrganizationWorkloadIdentityRemove.message(@username, @organization) %>
</p>

<p style="color: #304254; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">
  <%= for line <- OrganizationWorkloadIdentityDetails.lines(@role, @repository_owner, @repository, @workflow, @environment, @packages) do %>
    <%= line %><br>
  <% end %>
</p>
