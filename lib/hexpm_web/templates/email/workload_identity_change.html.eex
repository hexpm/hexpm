<h1 style="color: #030913; font-size: 24px; line-height: 32px; font-weight: 600; margin: 0 0 24px 0; text-align: center;">
  Workload Identity Changed on Package
</h1>

<p style="color: #304254; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">
  <%= raw(WorkloadIdentityChange.message(@username, @package, :html)) %>
</p>

<p style="color: #304254; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">
  <%= WorkloadIdentityChange.before() %><br>
  <%= for line <- WorkloadIdentityDetails.lines(@previous) do %>
    <%= line %><br>
  <% end %>
</p>

<p style="color: #304254; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">
  <%= WorkloadIdentityChange.now() %><br>
  <%= for line <- WorkloadIdentityDetails.lines(@current) do %>
    <%= line %><br>
  <% end %>
</p>

<p style="color: #304254; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">
  <%= raw(WorkloadIdentityChange.warning(@package, :html)) %>
</p>
