<div class="bg-grey-50 dark:bg-grey-950 py-10 px-4 flex-1 flex flex-col">
  <div class="max-w-7xl mx-auto w-full flex gap-8 flex-col lg:flex-row">
    <%!-- Sidebar --%>
    <aside class="w-full lg:w-64 shrink-0">
      <style nonce={@style_src_nonce}>
        /*
         * From lg up the nav is a plain sidebar, so the disclosure is
         * neutralized rather than duplicated. Both rules are needed: engines
         * that render details content through ::details-content ignore
         * `display` on the panel, and engines without that pseudo-element
         * ignore the first rule.
         */
        @media (min-width: 64rem) {
          .docs-nav > summary {
            display: none;
          }
          .docs-nav::details-content {
            content-visibility: visible;
          }
          .docs-nav > .docs-nav-panel {
            display: block;
          }
        }

        /*
         * Below lg it is an off-canvas drawer. The backdrop and the close
         * button sit inside <summary>, so clicking either one closes the
         * drawer, while clicks on the links inside the panel are unaffected.
         */
        @media (max-width: 63.9375rem) {
          .docs-nav-panel {
            position: fixed;
            inset-block: 0;
            left: 0;
            z-index: 50;
            width: 20rem;
            max-width: 80vw;
            overflow-y: auto;
            overscroll-behavior: contain;
            border-radius: 0;
            border-width: 0 1px 0 0;
          }
          .docs-nav-backdrop {
            position: fixed;
            inset: 0;
            z-index: 40;
            background-color: rgb(0 0 0 / 0.5);
          }
          .docs-nav-close {
            position: fixed;
            top: 0.75rem;
            left: min(20rem, 80vw);
            z-index: 60;
            margin-left: 0.5rem;
          }
          .docs-nav:not([open]) .docs-nav-backdrop,
          .docs-nav:not([open]) .docs-nav-close {
            display: none;
          }
        }
      </style>

      <details class="docs-nav group lg:sticky lg:top-4">
        <summary class="list-none rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 [&::-webkit-details-marker]:hidden">
          <div class="docs-nav-trigger flex cursor-pointer items-center justify-between gap-4 rounded-lg border border-grey-200 bg-white p-4 shadow-xs dark:border-grey-700 dark:bg-grey-900">
            <div class="flex min-w-0 items-center gap-3">
              {icon(:heroicon, "book-open",
                class: "size-5 shrink-0 text-grey-500 dark:text-grey-300"
              )}
              <div class="min-w-0">
                <p class="text-[10px] font-medium uppercase tracking-wide text-grey-400 dark:text-grey-300">
                  Documentation
                </p>

                <p class="truncate text-sm font-semibold text-grey-900 dark:text-grey-100">
                  {@title}
                </p>
              </div>
            </div>

            <div class="flex shrink-0 items-center gap-2 text-grey-500 dark:text-grey-300">
              <span class="text-xs font-medium">Browse</span>
              {icon(:heroicon, "bars-3", class: "size-4 shrink-0")}
            </div>
          </div>

          <div class="docs-nav-backdrop" aria-hidden="true"></div>

          <span
            class="docs-nav-close flex size-10 cursor-pointer items-center justify-center rounded-lg bg-grey-800/90 text-white shadow-lg dark:bg-grey-700"
            aria-hidden="true"
          >
            {icon(:heroicon, "x-mark", class: "size-5")}
          </span>
        </summary>

        <nav
          aria-label="Documentation"
          tabindex="-1"
          class="docs-nav-panel border border-grey-200 bg-white p-4 shadow-xs lg:rounded-lg dark:border-grey-700 dark:bg-grey-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
        >
          <div class="space-y-6">
            <div>
              <h3 class="text-sm font-semibold text-grey-900 dark:text-grey-100 mb-2">Mix</h3>

              <ul class="space-y-1">
                <li>
                  <a
                    href={~p"/docs/usage"}
                    class={[
                      "block px-3 py-1.5 text-sm rounded transition-colors",
                      if(@view_name == :usage,
                        do:
                          "bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-200 font-medium",
                        else:
                          "text-grey-700 dark:text-grey-200 hover:bg-grey-50 dark:hover:bg-grey-700"
                      )
                    ]}
                  >
                    Usage
                  </a>
                </li>

                <li>
                  <a
                    href={~p"/docs/publish"}
                    class={[
                      "block px-3 py-1.5 text-sm rounded transition-colors",
                      if(@view_name == :publish,
                        do:
                          "bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-200 font-medium",
                        else:
                          "text-grey-700 dark:text-grey-200 hover:bg-grey-50 dark:hover:bg-grey-800"
                      )
                    ]}
                  >
                    Publishing packages
                  </a>
                </li>

                <li>
                  <a
                    href={~p"/docs/private"}
                    class={[
                      "block px-3 py-1.5 text-sm rounded transition-colors",
                      if(@view_name == :private,
                        do:
                          "bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-200 font-medium",
                        else:
                          "text-grey-700 dark:text-grey-200 hover:bg-grey-50 dark:hover:bg-grey-800"
                      )
                    ]}
                  >
                    Private packages
                  </a>
                </li>

                <li>
                  <a
                    href={~p"/docs/dependency-policies"}
                    class={[
                      "block px-3 py-1.5 text-sm rounded transition-colors",
                      if(@view_name == :dependency_policies,
                        do:
                          "bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-200 font-medium",
                        else:
                          "text-grey-700 dark:text-grey-200 hover:bg-grey-50 dark:hover:bg-grey-800"
                      )
                    ]}
                  >
                    Dependency policies
                  </a>
                </li>

                <li>
                  <a
                    target="_blank"
                    rel="noopener"
                    href="https://hexdocs.pm/hex"
                    class="block px-3 py-1.5 text-sm rounded text-grey-700 dark:text-grey-200 hover:bg-grey-50 dark:hover:bg-grey-700 flex items-center gap-1"
                  >
                    Tasks {icon(:heroicon, "window", class: "w-3 h-3")}
                  </a>
                </li>
              </ul>
            </div>

            <div>
              <h3 class="text-sm font-semibold text-grey-900 dark:text-grey-100 mb-2">Rebar</h3>

              <ul class="space-y-1">
                <li>
                  <a
                    href={~p"/docs/rebar3-usage"}
                    class={[
                      "block px-3 py-1.5 text-sm rounded transition-colors",
                      if(@view_name == :rebar3_usage,
                        do:
                          "bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-200 font-medium",
                        else:
                          "text-grey-700 dark:text-grey-200 hover:bg-grey-50 dark:hover:bg-grey-700"
                      )
                    ]}
                  >
                    Usage
                  </a>
                </li>

                <li>
                  <a
                    href={~p"/docs/rebar3-publish"}
                    class={[
                      "block px-3 py-1.5 text-sm rounded transition-colors",
                      if(@view_name == :rebar3_publish,
                        do:
                          "bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-200 font-medium",
                        else:
                          "text-grey-700 dark:text-grey-200 hover:bg-grey-50 dark:hover:bg-grey-800"
                      )
                    ]}
                  >
                    Publishing packages
                  </a>
                </li>

                <li>
                  <a
                    href={~p"/docs/rebar3-private"}
                    class={[
                      "block px-3 py-1.5 text-sm rounded transition-colors",
                      if(@view_name == :rebar3_private,
                        do:
                          "bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-200 font-medium",
                        else:
                          "text-grey-700 dark:text-grey-200 hover:bg-grey-50 dark:hover:bg-grey-800"
                      )
                    ]}
                  >
                    Private packages
                  </a>
                </li>

                <li>
                  <a
                    target="_blank"
                    rel="noopener"
                    href="https://rebar3.org/docs/package_management/hex_package_management/"
                    class="block px-3 py-1.5 text-sm rounded text-grey-700 dark:text-grey-200 hover:bg-grey-50 dark:hover:bg-grey-700 flex items-center gap-1"
                  >
                    Tasks {icon(:heroicon, "window", class: "w-3 h-3")}
                  </a>
                </li>
              </ul>
            </div>

            <div>
              <h3 class="text-sm font-semibold text-grey-900 dark:text-grey-100 mb-2">Gleam</h3>

              <ul class="space-y-1">
                <li>
                  <a
                    href={~p"/docs/gleam-usage"}
                    class={[
                      "block px-3 py-1.5 text-sm rounded transition-colors",
                      if(@view_name == :gleam_usage,
                        do:
                          "bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-200 font-medium",
                        else:
                          "text-grey-700 dark:text-grey-200 hover:bg-grey-50 dark:hover:bg-grey-700"
                      )
                    ]}
                  >
                    Usage
                  </a>
                </li>

                <li>
                  <a
                    target="_blank"
                    rel="noopener"
                    href="https://gleam.run/command-line-reference/"
                    class="block px-3 py-1.5 text-sm rounded text-grey-700 dark:text-grey-200 hover:bg-grey-50 dark:hover:bg-grey-700 flex items-center gap-1"
                  >
                    Tasks {icon(:heroicon, "window", class: "w-3 h-3")}
                  </a>
                </li>
              </ul>
            </div>

            <div>
              <h3 class="text-sm font-semibold text-grey-900 dark:text-grey-100 mb-2">Hex</h3>

              <ul class="space-y-1">
                <li :if={Hexpm.Accounts.SSO.available?()}>
                  <a
                    href={~p"/docs/organization-sso"}
                    class={[
                      "block px-3 py-1.5 text-sm rounded transition-colors",
                      if(@view_name == :organization_sso,
                        do:
                          "bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-200 font-medium",
                        else:
                          "text-grey-700 dark:text-grey-200 hover:bg-grey-50 dark:hover:bg-grey-700"
                      )
                    ]}
                  >
                    Organization SSO
                  </a>
                </li>

                <li>
                  <a
                    href={~p"/docs/faq"}
                    class={[
                      "block px-3 py-1.5 text-sm rounded transition-colors",
                      if(@view_name == :faq,
                        do:
                          "bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-200 font-medium",
                        else:
                          "text-grey-700 dark:text-grey-200 hover:bg-grey-50 dark:hover:bg-grey-700"
                      )
                    ]}
                  >
                    FAQ
                  </a>
                </li>

                <li>
                  <a
                    href={~p"/docs/self-hosting"}
                    class={[
                      "block px-3 py-1.5 text-sm rounded transition-colors",
                      if(@view_name == :self_hosting,
                        do:
                          "bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-200 font-medium",
                        else:
                          "text-grey-700 dark:text-grey-200 hover:bg-grey-50 dark:hover:bg-grey-800"
                      )
                    ]}
                  >
                    Self-hosting
                  </a>
                </li>

                <li>
                  <a
                    href={~p"/docs/mirrors"}
                    class={[
                      "block px-3 py-1.5 text-sm rounded transition-colors",
                      if(@view_name == :mirrors,
                        do:
                          "bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-200 font-medium",
                        else:
                          "text-grey-700 dark:text-grey-200 hover:bg-grey-50 dark:hover:bg-grey-800"
                      )
                    ]}
                  >
                    Mirrors
                  </a>
                </li>

                <li>
                  <a
                    href={~p"/docs/public-keys"}
                    class={[
                      "block px-3 py-1.5 text-sm rounded transition-colors",
                      if(@view_name == :public_keys,
                        do:
                          "bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-200 font-medium",
                        else:
                          "text-grey-700 dark:text-grey-200 hover:bg-grey-50 dark:hover:bg-grey-800"
                      )
                    ]}
                  >
                    Public keys
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </nav>
      </details>
    </aside>
    <%!-- Content --%>
    <main class="flex-1 min-w-0">
      <article class="bg-white dark:bg-grey-800 border border-grey-200 dark:border-grey-700 rounded-lg p-6 lg:p-10 shadow-xs docs-content">
        <style nonce={@style_src_nonce}>
          .docs-content h2 {
            font-size: 1.875rem;
            font-weight: 700;
            color: var(--color-grey-900);
            margin-bottom: 1.5rem;
          }
          .docs-content h3 {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--color-grey-900);
            margin-top: 2rem;
            margin-bottom: 1rem;
          }
          .docs-content h4 {
            font-size: 1.125rem;
            font-weight: 600;
            color: var(--color-grey-900);
            margin-top: 1.5rem;
            margin-bottom: 0.75rem;
          }
          .docs-content h2 > a,
          .docs-content h3 > a,
          .docs-content h4 > a {
            display: none;
            margin-left: 0.5rem;
          }
          .docs-content h2:hover > a,
          .docs-content h3:hover > a,
          .docs-content h4:hover > a {
            display: inline-block;
          }
          .docs-content h2 > a svg,
          .docs-content h3 > a svg,
          .docs-content h4 > a svg {
            width: 0.875rem;
            height: 0.875rem;
            color: var(--color-grey-300);
          }
          .docs-content h2 > a:hover svg,
          .docs-content h3 > a:hover svg,
          .docs-content h4 > a:hover svg {
            color: var(--color-blue-600);
          }
          .docs-content p {
            font-size: 1rem;
            line-height: 1.75;
            color: var(--color-grey-600);
            margin-bottom: 1rem;
          }
          .docs-content a {
            color: var(--color-blue-600);
            text-decoration: underline;
            font-weight: 500;
          }
          .docs-content a:hover {
            color: var(--color-blue-700);
          }
          .docs-content strong {
            font-weight: 600;
            color: var(--color-grey-900);
          }
          .docs-content code:not(pre code) {
            background-color: var(--color-grey-50);
            padding: 0.125rem 0.375rem;
            border-radius: 0.25rem;
            font-size: 0.875rem;
            font-family: ui-monospace, monospace;
            color: var(--color-grey-800);
          }
          .docs-content pre {
            overflow-x: auto;
            margin-bottom: 1rem;
          }
          .docs-content pre code {
            padding: 0;
            background: transparent;
            font-size: 0.875rem;
          }
          html[data-theme="dark"] .docs-content h2,
          html[data-theme="dark"] .docs-content h3,
          html[data-theme="dark"] .docs-content h4,
          html[data-theme="dark"] .docs-content strong {
            color: white;
          }
          html[data-theme="dark"] .docs-content h2 > a svg,
          html[data-theme="dark"] .docs-content h3 > a svg,
          html[data-theme="dark"] .docs-content h4 > a svg {
            color: var(--color-grey-300);
          }
          html[data-theme="dark"] .docs-content h2 > a:hover svg,
          html[data-theme="dark"] .docs-content h3 > a:hover svg,
          html[data-theme="dark"] .docs-content h4 > a:hover svg {
            color: var(--color-blue-200);
          }
          html[data-theme="dark"] .docs-content p {
            color: var(--color-grey-200);
          }
          html[data-theme="dark"] .docs-content a {
            color: var(--color-blue-300);
          }
          html[data-theme="dark"] .docs-content a:hover {
            color: var(--color-blue-200);
          }
          html[data-theme="dark"] .docs-content code:not(pre code) {
            background-color: var(--color-grey-700);
            color: var(--color-grey-100);
          }
          .docs-content ul, .docs-content ol {
            padding-left: 1.5rem;
            margin-bottom: 1rem;
            line-height: 1.75;
          }
          .docs-content ul {
            list-style-type: disc;
          }
          .docs-content ol {
            list-style-type: decimal;
          }
          .docs-content li {
            color: var(--color-grey-600);
            margin-bottom: 0.5rem;
          }
          .docs-content blockquote {
            border-left: 4px solid var(--color-blue-600);
            padding-left: 1rem;
            font-style: italic;
            color: var(--color-grey-500);
            margin-bottom: 1rem;
          }
          .docs-content table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 1.5rem;
            font-size: 0.875rem;
          }
          .docs-content table th {
            background-color: var(--color-grey-50);
            font-weight: 600;
            color: var(--color-grey-900);
            padding: 0.75rem 1rem;
            border-bottom: 2px solid var(--color-grey-200);
            text-align: left;
          }
          .docs-content table td {
            padding: 0.75rem 1rem;
            color: var(--color-grey-700);
            border-bottom: 1px solid var(--color-grey-200);
          }
          .docs-content table.table-striped tbody tr:nth-child(even) {
            background-color: var(--color-grey-100);
          }
          .docs-content table.table-striped tbody tr:hover {
            background-color: var(--color-grey-200);
          }
          .docs-content dl {
            margin-bottom: 1rem;
          }
          .docs-content dt {
            font-weight: 600;
            color: var(--color-grey-900);
            margin-top: 0.75rem;
          }
          .docs-content dt:first-child {
            margin-top: 0;
          }
          .docs-content dd {
            color: var(--color-grey-600);
            margin-left: 1rem;
            line-height: 1.75;
          }
          html[data-theme="dark"] .docs-content li {
            color: var(--color-grey-200);
          }
          html[data-theme="dark"] .docs-content blockquote {
            border-left-color: var(--color-blue-300);
            color: var(--color-grey-300);
          }
          html[data-theme="dark"] .docs-content dt {
            color: var(--color-grey-100);
          }
          html[data-theme="dark"] .docs-content dd {
            color: var(--color-grey-300);
          }
          html[data-theme="dark"] .docs-content table th {
            background-color: var(--color-grey-700);
            color: white;
            border-bottom-color: var(--color-grey-600);
          }
          html[data-theme="dark"] .docs-content table td {
            color: var(--color-grey-200);
            border-bottom-color: var(--color-grey-600);
          }
          html[data-theme="dark"] .docs-content table.table-striped tbody tr:nth-child(even) {
            background-color: var(--color-grey-700);
          }
          html[data-theme="dark"] .docs-content table.table-striped tbody tr:hover {
            background-color: var(--color-grey-500);
          }
        </style>
        {render(DocsView, @view, assigns)}
      </article>
    </main>
  </div>
</div>
