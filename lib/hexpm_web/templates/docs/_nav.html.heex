<div class="space-y-6">
  <%= for {heading, links} <- docs_sections() do %>
    <div>
      <h3 class="text-sm font-semibold text-grey-900 dark:text-grey-100 mb-2">{heading}</h3>
      <ul class="space-y-1">
        <%= for link <- links do %>
          <li>
            <%= if link[:external] do %>
              <a
                target="_blank"
                rel="noopener"
                href={link.href}
                class={[docs_link_class(false), "flex items-center gap-1"]}
              >
                {link.label} {icon(:heroicon, "window", class: "w-3 h-3")}
              </a>
            <% else %>
              <a href={link.href} class={docs_link_class(@view_name == link.view)}>
                {link.label}
              </a>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>
