<div class="bg-grey-50 dark:bg-grey-950 min-h-screen py-4 sm:py-8">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex flex-col gap-4 sm:gap-8 lg:flex-row">
      <div class="w-full lg:w-64 flex-shrink-0">
        {render(HexpmWeb.DashboardView, "_sidebar.html", assigns)}
      </div>
      <div class="flex-1 min-w-0">
        <section class="bg-white dark:bg-grey-800 border border-grey-200 dark:border-grey-700 rounded-lg p-4 sm:p-6 text-grey-700 dark:text-grey-200">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-xl font-semibold text-grey-900 dark:text-white">
              Publish approval
            </h2>
            <.badge
              variant={if @organization.require_publish_approval, do: "green", else: "default"}
              class={
                if @organization.require_publish_approval,
                  do: "dark:bg-green-950 dark:text-green-200",
                  else: "dark:bg-grey-700 dark:text-grey-200"
              }
            >
              {if @organization.require_publish_approval, do: "Enabled", else: "Disabled"}
            </.badge>
          </div>
          <p class="mt-4">
            Require a user with two-factor authentication to approve releases and documentation
            published to {@organization.name}'s private repository with an API key or workload identity.
          </p>
          <p
            :if={Hexpm.Repository.StagedReleases.forced?()}
            class="mt-5 rounded-lg border border-blue-200 dark:border-blue-800 bg-blue-50 dark:bg-blue-950 p-4 text-sm text-blue-900 dark:text-blue-100"
          >
            The registry currently requires approval for all automated publishes. Disabling the organization policy won't disable that requirement.
          </p>
          <p class="mt-3 text-sm text-grey-600 dark:text-grey-300">
            This organization policy applies even when approval is disabled for an individual package.
            Publishing with OAuth and an OTP stays direct.
          </p>
          <div class="mt-6 pt-5 border-t border-grey-200 dark:border-grey-700">
            <%= if @organization.require_publish_approval do %>
              <p class="text-sm text-grey-600 dark:text-grey-300 mb-4">
                Publish approval is enabled.
              </p>
              <.button
                type="button"
                phx-click={show_modal("disable-publish-approval-modal")}
                variant="danger"
              >
                Disable publish approval
              </.button>
            <% else %>
              <p class="text-sm text-grey-600 dark:text-grey-300 mb-4">
                Publish approval is disabled.
              </p>
              <.sudo_form
                current_user={@current_user}
                action={~p"/dashboard/orgs/#{@organization}/publish-approval/enable"}
              >
                <.button type="submit">Enable publish approval</.button>
              </.sudo_form>
            <% end %>
          </div>
        </section>

        <.modal
          :if={@organization.require_publish_approval}
          id="disable-publish-approval-modal"
          title="Disable organization approval"
          max_width="md"
        >
          <p class="font-medium text-grey-900 dark:text-white">
            Publish approval is currently enabled for {@organization.name}.
          </p>
          <p class="mt-3 text-grey-700 dark:text-grey-300">
            Disabling it allows direct publishing to the private repository unless a package or registry policy requires approval.
          </p>
          <p
            :if={Hexpm.Repository.StagedReleases.forced?()}
            class="mt-5 rounded-lg border border-blue-200 dark:border-blue-800 bg-blue-50 dark:bg-blue-950 p-4 text-sm text-blue-900 dark:text-blue-100"
          >
            The registry currently requires approval for all automated publishes. Disabling the organization policy won't disable that requirement.
          </p>
          <p class="mt-3 text-sm text-grey-600 dark:text-grey-300">
            Existing staged releases still need approval. Every administrator will receive an email.
          </p>
          <:footer>
            <.button
              type="button"
              variant="secondary"
              phx-click={hide_modal("disable-publish-approval-modal")}
            >
              Cancel
            </.button>
            <.sudo_form
              current_user={@current_user}
              action={~p"/dashboard/orgs/#{@organization}/publish-approval/disable"}
              class="m-0"
            >
              <.button type="submit" variant="danger">Disable approval</.button>
            </.sudo_form>
          </:footer>
        </.modal>
      </div>
    </div>
  </div>
</div>
