<.auth_layout
  title="Continue with organization SSO"
  subtitle={"Finish signing in with #{@organization.name}'s identity provider"}
  show_oauth={false}
>
  <div class="space-y-5 text-sm text-grey-700 dark:text-grey-200">
    <p>
      You authenticated with the organization's identity provider. Continue only if you started this login.
    </p>
    <p>
      Hexpm will recheck the SSO connection, linked identity, and organization membership before signing you in.
    </p>
  </div>

  <div class="mt-8 flex gap-3">
    <.form for={%{}} action={~p"/sso/continue"} class="flex-1">
      <.button type="submit" variant="primary" full_width>Continue</.button>
    </.form>
    <.form for={%{}} action={~p"/sso/continue/cancel"} class="flex-1">
      <.button type="submit" variant="secondary" full_width>Cancel</.button>
    </.form>
  </div>
</.auth_layout>
