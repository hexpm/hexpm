<.auth_layout
  title="Authenticate a session"
  subtitle="Complete your organizations' authentication requirements"
  show_oauth={false}
>
  <div class="space-y-5 text-sm text-grey-700 dark:text-grey-200">
    <p>
      You are signed in as <strong class="break-words font-semibold text-grey-900 dark:text-grey-100">{@current_user.username}</strong>.
    </p>
    <p>
      Complete the checks below to allow
      <strong class="break-words font-semibold text-grey-900 dark:text-grey-100">{@session.name ||
        "an unnamed session"}</strong>
      to access the listed organizations.
    </p>

    <p class="text-grey-600 dark:text-grey-300">
      The application that created this session chose its name. It signed in {session_started(
        @session
      )} and {session_last_used(@session)}. If you don't recognize this session, cancel this request and review your <a
        href={~p"/dashboard/sessions"}
        class="font-medium text-primary-600 dark:text-primary-300 hover:underline"
      >sessions</a>.
    </p>

    <ul class="list-none space-y-2">
      <li
        :for={{organization, authenticated?} <- @organizations}
        class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between rounded-lg border border-grey-200 dark:border-grey-700 px-4 py-3"
      >
        <div class="w-full min-w-0 sm:w-auto">
          <strong class="block break-words font-semibold text-grey-900 dark:text-grey-100">{organization.name}</strong>
          <p :for={
            requirement <-
              Hexpm.Accounts.SSO.authorization_requirements(
                @authorization,
                organization,
                @approving_browser
              )
          }>
            {case requirement do
              "tfa" -> "2FA verification required"
              "sso" -> "SSO authentication required"
            end}
          </p>
        </div>
        <span :if={authenticated?} class="text-sm text-grey-600 dark:text-grey-300">
          Authenticated
        </span>
        <.form
          :if={!authenticated?}
          for={%{}}
          action={~p"/organizations/authorize"}
          class="shrink-0"
        >
          <input type="hidden" name="code" value={@code} />
          <input type="hidden" name="organization" value={organization.name} />
          <.button type="submit" variant="primary">Authenticate</.button>
        </.form>
      </li>
    </ul>

    <.form for={%{}} action={~p"/organizations/authorize"}>
      <input type="hidden" name="code" value={@code} />
      <.button type="submit" name="action" value="cancel" variant="outline">Cancel</.button>
    </.form>
    <p>
      The session keeps its original expiry. Each organization's authentication policy determines
      how long verification remains valid. 2FA verification applies to the account session;
      SSO authentication applies to the listed organizations.
    </p>
  </div>
</.auth_layout>
