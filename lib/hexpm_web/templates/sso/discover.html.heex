<.auth_layout
  title="Organization SSO"
  subtitle="Enter your work email to find your organization's sign-in"
>
  <.form for={%{}} action={~p"/sso/discover"} id="sso-discovery-form" class="space-y-6">
    <.text_input id="email" name="email" type="email" label="Work Email" required />

    <.button type="submit" full_width class="mt-8">
      Continue
    </.button>
  </.form>

  <p :if={@result == :none} class="text-small text-grey-800 dark:text-grey-200 mt-6">
    We could not find an organization SSO sign-in for that email. Use the organization's
    direct SSO link, or log in with your Hexpm credentials.
  </p>

  <:footer_links>
    <p class="text-small text-center mt-8">
      <.text_link href={~p"/login"} variant="secondary">
        Log in another way
      </.text_link>
    </p>
  </:footer_links>
</.auth_layout>
