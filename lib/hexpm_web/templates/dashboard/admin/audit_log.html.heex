<div class="bg-grey-50 dark:bg-grey-950 min-h-screen py-4 sm:py-8">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex flex-col gap-4 sm:gap-8 lg:flex-row">
      <%!-- Left Sidebar --%>
      <div class="w-full lg:w-64 flex-shrink-0">
        {render(HexpmWeb.DashboardView, "_sidebar.html", assigns)}
      </div>

      <%!-- Right Content --%>
      <div class="flex-1 min-w-0">
        <div class="bg-white dark:bg-grey-800 border border-grey-200 dark:border-grey-700 rounded-lg p-4 sm:p-8">
          <h2 class="text-grey-900 dark:text-white text-xl font-semibold mb-2">
            Admin audit log
          </h2>
          <p class="text-grey-600 dark:text-grey-300 text-sm mb-6">
            Every run of an admin task, from this dashboard, the console or a background job.
          </p>

          <p :if={@audit_logs == []} class="text-grey-600 dark:text-grey-300 text-sm">
            No admin tasks have been run.
          </p>

          <.audit_table :if={@audit_logs != []} audit_logs={@audit_logs} />

          <%= if @audit_logs != [] do %>
            {render(HexpmWeb.SharedView, "_pagination.html",
              items: @audit_logs,
              page: @page,
              total_count: @total_count,
              per_page: @per_page,
              unit: "entry",
              units: "entries",
              path_fn: @path_fn
            )}
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
