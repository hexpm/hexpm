<div class="bg-grey-50 dark:bg-grey-950 min-h-screen py-4 sm:py-8">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex flex-col gap-4 sm:gap-8 lg:flex-row">
      <%!-- Left Sidebar --%>
      <div class="w-full lg:w-64 flex-shrink-0">
        {render(HexpmWeb.DashboardView, "_sidebar.html", assigns)}
      </div>

      <%!-- Right Content --%>
      <div class="flex-1 min-w-0 flex flex-col gap-6">
        <div class="bg-white dark:bg-grey-800 border border-grey-200 dark:border-grey-700 rounded-lg p-4 sm:p-8">
          <a
            href={back_path(@task, @args)}
            class="inline-flex items-center gap-2 text-grey-600 dark:text-grey-300 text-sm mb-4 hover:text-grey-900 dark:hover:text-white"
          >
            {icon(:heroicon, "arrow-left", class: "w-4 h-4")} {@task.title}
          </a>
          <h2 class="text-grey-900 dark:text-white text-xl font-semibold">
            Review {@task.title}
          </h2>

          <p :if={@error} id="preview-error" class="text-red-700 dark:text-red-400 text-sm mt-4">
            Nothing to run, {inspect(@error)}.
          </p>

          <div :if={@preview} class="mt-6">
            <.user_summary :if={@preview.kind == :user} lookup={@preview.lookup} />
            <.package_summary :if={@preview.kind == :package} lookup={@preview.lookup} />
            <.organization_summary :if={@preview.kind == :organization} lookup={@preview.lookup} />
          </div>
        </div>

        <div
          :if={@preview}
          id="confirm"
          class="bg-white dark:bg-grey-800 border border-red-300 dark:border-red-800 rounded-lg p-4 sm:p-8"
        >
          <h3 class="text-grey-900 dark:text-white text-lg font-semibold mb-4">
            What happens
          </h3>
          <ul class="list-disc pl-5 space-y-1 text-sm text-grey-900 dark:text-grey-100">
            <li :for={consequence <- consequences(@task.id, @preview)}>{consequence}</li>
          </ul>

          <%!-- Not a sudo_form: it carries the task form's token instead of
               signing a new one, see HexpmWeb.Dashboard.AdminController. --%>
          <.form
            for={%{}}
            action={~p"/dashboard/admin/tasks/#{@task.id}"}
            id="confirm-form"
            class="mt-6"
          >
            <input :if={@sudo_token} type="hidden" name="_sudo_token" value={@sudo_token} />
            <input
              :for={{key, value} <- @args}
              type="hidden"
              name={"args[#{key}]"}
              value={value}
            />
            <div class="max-w-md">
              <.text_input
                id="confirm-name"
                name="confirm"
                label={"Type #{@preview.name} to confirm"}
                required
                autocomplete="off"
              />
              <p :if={@mismatch} class="text-red-700 dark:text-red-400 text-sm mt-2">
                That isn't {@preview.name}.
              </p>
            </div>
            <div class="mt-6">
              <.button type="submit" variant="danger">{@task.title}</.button>
            </div>
          </.form>
        </div>
      </div>
    </div>
  </div>
</div>
